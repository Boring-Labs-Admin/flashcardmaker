# Google Gemini API Key
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase Configuration
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare Turnstile (captcha on email sign-up / sign-in / password reset)
# Public site key from: https://dash.cloudflare.com/?to=/:account/turnstile
# The matching SECRET key is NOT stored here — enter it in Supabase: Authentication → Attack Protection.
# Leave unset locally to skip the captcha (only works if captcha is also off in Supabase).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Vercel Postgres Connection String (optional - can use Supabase instead)
# Auto-generated when you create Postgres storage in Vercel
POSTGRES_URL=postgres://default:xxxxx@xxxxx.postgres.vercel-storage.com:5432/verceldb

# Optional: Google Analytics (if you want tracking)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
